-- USERS / PROFILES
create table profiles (
  id uuid primary key,                     -- matches auth.users.id
  full_name text,
  email text,
  role text default 'user',               -- 'user' or 'admin'
  created_at timestamp default now()
);

-- PRODUCTS
create table products (
  id bigint generated by default as identity primary key,
  name text,
  price numeric,
  description text,
  seller_name text,
  seller_id uuid,
  status text default 'pending',          -- pending → approved
  created_at timestamp default now()
);

-- ORDERS
create table orders (
  id bigint generated by default as identity primary key,
  user_id uuid,
  total numeric,
  status text default 'pending',
  created_at timestamp default now()
);

-- ORDER ITEMS
create table order_items (
  id bigint generated by default as identity primary key,
  order_id bigint,
  product_id bigint,
  name text,
  price numeric
);

-- READ OWN PROFILE
create policy "Users can read own profile"
on profiles
for select
to authenticated
using (auth.uid() = id);

-- INSERT OWN PROFILE
create policy "Users can insert profile"
on profiles
for insert
to authenticated
with check (auth.uid() = id);

-- UPDATE OWN PROFILE
create policy "Users can update own profile"
on profiles
for update
to authenticated
using (auth.uid() = id);

-- READ PRODUCTS (PUBLIC)
create policy "Anyone can read products"
on products
for select
to public
using (true);

-- INSERT PRODUCTS (LOGGED-IN USERS ONLY)
create policy "Users can insert products"
on products
for insert
to authenticated
with check (auth.uid() = seller_id);

-- UPDATE PRODUCTS (TEMP ADMIN - open)
create policy "Update products"
on products
for update
to public
using (true);

-- DELETE PRODUCTS (TEMP ADMIN - open)
create policy "Delete products"
on products
for delete
to public
using (true);


-- USERS READ THEIR OWN ORDERS
create policy "Users read own orders"
on orders
for select
to authenticated
using (auth.uid() = user_id);

-- INSERT ORDERS
create policy "Users insert orders"
on orders
for insert
to authenticated
with check (auth.uid() = user_id);

-- READ ORDER ITEMS (LINKED TO USER ORDERS)
create policy "Read order items"
on order_items
for select
to authenticated
using (true);

-- INSERT ORDER ITEMS
create policy "Insert order items"
on order_items
for insert
to authenticated
with check (true);

